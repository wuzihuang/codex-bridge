#!/usr/bin/env bash
# codex-imagegen — generate or edit an image with OpenAI gpt-image-2 through the
# Codex CLI, using your existing `codex login` (ChatGPT plan). No API key needed.
#
# Usage:
#   codex-imagegen "<prompt>" <output.png> [options]
#
# Options:
#   --size WxH        1024x1024 (default) | 1536x1024 | 1024x1536 | 1280x640 | 3840x2160
#                     Custom sizes: longest edge <= 3840, both edges multiples of
#                     16, ratio <= 3:1, total pixels 655,360-8,294,400.
#   --ref <file>      Image to EDIT. Repeatable (max 4 images total). Passing a
#                     --ref turns this into an edit: describe the change.
#   --style-ref <f>   Image used only as a style/composition reference for a NEW
#                     image (not edited). Repeatable; shares the 4-image cap.
#   --transparent     Ask for a genuinely transparent background (native alpha)
#                     and verify the PNG actually has an alpha channel.
#   --model <name>    Codex model. Default: latest — the newest model in your
#                     Codex catalog (see `codex-models`). `default` = whatever
#                     your ~/.codex/config.toml says. Env: CODEX_BRIDGE_MODEL.
#   --effort <level>  Reasoning effort for the driving model (low | medium |
#                     high | xhigh | ...). Default: medium. The model only has
#                     to shape the prompt and call the image tool, so high
#                     effort mostly adds latency. Env: CODEX_BRIDGE_IMAGE_EFFORT.
#   --timeout <sec>   Abort after N seconds (default: 600)
#
# Examples:
#   codex-imagegen "flat vector rocket icon, blue #2563EB, minimal" ./rocket.png
#   codex-imagegen "make the sky sunset orange, keep everything else identical" \
#       ./out.png --ref ./original.png
#   codex-imagegen "a mascot fox, sticker style" ./fox.png --transparent
#
# Output: absolute path of the written PNG on stdout.
# Exit:   0 ok | 1 usage/precondition | 2 generation failed | 124 timed out.

set -uo pipefail

err() { printf 'codex-imagegen: %s\n' "$*" >&2; }

# mtime <file> — GNU stat first (Linux), BSD stat fallback (macOS)
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

usage() {
  sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

[ $# -ge 2 ] || usage

PROMPT="$1"; shift
OUTPUT="$1"; shift
SIZE=""
MODEL="${CODEX_BRIDGE_MODEL:-latest}"
EFFORT="${CODEX_BRIDGE_IMAGE_EFFORT:-medium}"
TRANSPARENT=0
TIMEOUT=600
REFS=()
STYLE_REFS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --size)    SIZE="${2:-}"; shift 2 ;;
    --model)   MODEL="${2:-}"; shift 2 ;;
    --timeout) TIMEOUT="${2:-}"; shift 2 ;;
    --effort)  EFFORT="${2:-}"; shift 2 ;;
    --ref)     REFS+=("${2:-}"); shift 2 ;;
    --style-ref) STYLE_REFS+=("${2:-}"); shift 2 ;;
    --transparent) TRANSPARENT=1; shift ;;
    -h|--help) usage ;;
    *) err "unknown argument: $1"; usage ;;
  esac
done

[ -n "$PROMPT" ] || { err "prompt is empty"; exit 1; }
[ -n "$OUTPUT" ] || { err "output path is empty"; exit 1; }

N_IMAGES=$(( ${#REFS[@]} + ${#STYLE_REFS[@]} ))
if [ "$N_IMAGES" -gt 4 ]; then
  err "at most 4 --ref/--style-ref images are supported in total (got ${N_IMAGES})"
  exit 1
fi

# --- Preconditions -----------------------------------------------------------
if ! command -v codex >/dev/null 2>&1; then
  err "codex CLI not found on PATH. Install it ('npm i -g @openai/codex' or 'brew install codex') then run 'codex login'."
  exit 1
fi

if ! codex login status >/dev/null 2>&1; then
  err "codex is not logged in. Run 'codex login' in a terminal, then retry. (ChatGPT Plus/Pro/Team works; no API key needed.)"
  exit 1
fi

for r in "${REFS[@]:-}" "${STYLE_REFS[@]:-}"; do
  [ -n "$r" ] || continue
  if [ ! -f "$r" ]; then
    err "reference image not found: $r"
    exit 1
  fi
done

# --- Resolve the model -------------------------------------------------------
# `latest` is resolved against Codex's live catalog on every run, so the wrapper
# picks up a new model the day it ships. If the catalog can't be read we fall
# back to the user's config default rather than failing the generation.
case "$MODEL" in
  latest)
    RESOLVED="$("$(dirname "$0")/codex-models" --latest 2>/dev/null)"
    if [ -n "$RESOLVED" ]; then
      MODEL="$RESOLVED"
    else
      err "note: could not resolve the latest model; using your codex config default."
      MODEL=""
    fi
    ;;
  default|"") MODEL="" ;;
esac

# --- Resolve output path -----------------------------------------------------
case "$OUTPUT" in
  /*) : ;;
  *)  OUTPUT="$(pwd)/$OUTPUT" ;;
esac

OUTDIR="$(dirname "$OUTPUT")"
BASENAME="$(basename "$OUTPUT")"
mkdir -p "$OUTDIR"
OUTDIR="$(cd "$OUTDIR" && pwd)"   # normalize (collapse ./ and symlinked segments)
OUTPUT="$OUTDIR/$BASENAME"

# --- Build the instruction for Codex -----------------------------------------
# Note: \$imagegen must reach Codex literally — it names Codex's built-in
# image-generation skill.
SAVE_RULE="Save the final image to the exact path ./${BASENAME} in the current working directory. I explicitly authorize replacing any existing file at that path, so overwrite it in place - do NOT create a versioned sibling filename such as ${BASENAME%.*}-v2.${BASENAME##*.}. Do nothing else: no code changes, no extra files, no questions, no commentary."

# Attached images are numbered in the order they are passed: edit targets
# first, then style references — the instruction names them by that index.
N_EDIT=${#REFS[@]}
N_STYLE=${#STYLE_REFS[@]}
if [ "$N_EDIT" -gt 0 ]; then
  INSTRUCTION="Use the \$imagegen image generation tool to edit the attached image(s) 1-${N_EDIT} (the edit target). Preserve everything not mentioned in the change description. ${SAVE_RULE} Change to make: ${PROMPT}"
else
  INSTRUCTION="Use the \$imagegen image generation tool to generate exactly one image. ${SAVE_RULE} Image description: ${PROMPT}"
fi
if [ "$N_STYLE" -gt 0 ]; then
  INSTRUCTION="${INSTRUCTION} Attached image(s) $((N_EDIT + 1))-$((N_EDIT + N_STYLE)) are style references only: match their art style, palette, line weight and rendering, but do not copy their subject or edit them."
fi
if [ -n "$SIZE" ]; then
  INSTRUCTION="${INSTRUCTION} Desired image size: ${SIZE}."
fi
if [ "$TRANSPARENT" -eq 1 ]; then
  INSTRUCTION="${INSTRUCTION} The output must be a PNG with a genuinely transparent background: request a transparent background from the image tool and preserve its alpha channel. Do not fake it with a checkerboard, white, or chroma-key background."
fi

CMD=(codex exec -C "$OUTDIR" -s workspace-write --skip-git-repo-check)
[ -n "$MODEL" ] && CMD+=(-m "$MODEL")
[ -n "$EFFORT" ] && CMD+=(-c "model_reasoning_effort=\"$EFFORT\"")
for r in "${REFS[@]:-}" "${STYLE_REFS[@]:-}"; do
  [ -n "$r" ] || continue
  case "$r" in /*) ABS="$r" ;; *) ABS="$(cd "$(dirname "$r")" && pwd)/$(basename "$r")" ;; esac
  CMD+=(-i "$ABS")
done
# `--` is required, not cosmetic: codex's `-i/--image <FILE>...` is variadic, so
# without it the instruction is parsed as one more image filename and the prompt
# positional ends up empty (codex then blocks reading it from stdin).
CMD+=(-- "$INSTRUCTION")

START_EPOCH="$(date +%s)"

TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="gtimeout"
fi

# --- Run Codex non-interactively ---------------------------------------------
if [ -n "$TIMEOUT_BIN" ]; then
  CODEX_OUT="$("$TIMEOUT_BIN" "$TIMEOUT" "${CMD[@]}" 2>&1)"
  CODEX_STATUS=$?
else
  CODEX_OUT="$("${CMD[@]}" 2>&1)"
  CODEX_STATUS=$?
fi

if [ "$CODEX_STATUS" -eq 124 ]; then
  err "timed out after ${TIMEOUT}s. Raise --timeout or simplify the prompt."
  exit 124
fi

# --- Locate the result -------------------------------------------------------
# Three places to look, in order of preference:
#   1. exactly where we asked
#   2. a sibling versioned name — Codex's imagegen skill is instructed not to
#      overwrite existing assets and may write e.g. out-v2.png / out-edited.png
#   3. $CODEX_HOME/generated_images/<session-id>/*.png — the built-in image_gen
#      tool's default destination, nested one level under a session directory

is_png() { [ -s "$1" ] && [ "$(head -c 4 "$1" | od -An -tx1 | tr -d ' \n')" = "89504e47" ]; }

# has_alpha — PNG colour type (byte 25 of the IHDR) 4 or 6 carries an alpha
# channel; types 0/2/3 only do with a tRNS chunk.
has_alpha() {
  local ct
  ct="$(od -An -tu1 -j 25 -N 1 "$1" | tr -d ' ')"
  [ "$ct" = "4" ] || [ "$ct" = "6" ] || head -c 65536 "$1" | grep -q tRNS
}

# finish <path> — report success, warning when --transparent wasn't honoured.
finish() {
  if [ "$TRANSPARENT" -eq 1 ] && ! has_alpha "$1"; then
    err "warning: --transparent was requested but the PNG has no alpha channel. Regenerate, or fall back to the chroma-key recipe in the generate-image skill."
  fi
  printf '%s\n' "$1"
  exit 0
}

if is_png "$OUTPUT"; then
  finish "$OUTPUT"
fi

STEM="${BASENAME%.*}"
EXT="${BASENAME##*.}"
FOUND=""
FOUND_MTIME=0
for cand in "$OUTDIR/$STEM"-*."$EXT"; do
  [ -f "$cand" ] || continue
  is_png "$cand" || continue
  CM="$(mtime "$cand")"
  if [ "$CM" -ge "$START_EPOCH" ] && [ "$CM" -gt "$FOUND_MTIME" ]; then
    FOUND="$cand"
    FOUND_MTIME="$CM"
  fi
done
if [ -n "$FOUND" ]; then
  err "note: codex wrote '$(basename "$FOUND")' instead of '$BASENAME' (it avoids overwriting); using it."
  finish "$FOUND"
fi

GEN_DIR="${CODEX_HOME:-$HOME/.codex}/generated_images"
if [ -d "$GEN_DIR" ]; then
  NEWEST=""
  NEWEST_MTIME=0
  # Search the session subdirectories and the top level (older layouts).
  for f in "$GEN_DIR"/*/* "$GEN_DIR"/*; do
    [ -f "$f" ] || continue
    is_png "$f" || continue
    MTIME="$(mtime "$f")"
    if [ "$MTIME" -ge "$START_EPOCH" ] && [ "$MTIME" -gt "$NEWEST_MTIME" ]; then
      NEWEST="$f"
      NEWEST_MTIME="$MTIME"
    fi
  done
  if [ -n "$NEWEST" ]; then
    cp "$NEWEST" "$OUTPUT"
    finish "$OUTPUT"
  fi
fi

err "image was not produced (codex exit code: ${CODEX_STATUS}, model: ${MODEL:-config default})."
err "looked in: $OUTPUT , ${OUTDIR}/${STEM}-*.${EXT} , ${GEN_DIR}/*/*"
err "--- codex output (last 30 lines) ---"
printf '%s\n' "$CODEX_OUT" | tail -n 30 >&2
exit 2
